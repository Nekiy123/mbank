<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>МБанк — Цифровой банк</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: system-ui, sans-serif;
            background: #f4f7fc;
            color: #1a2639;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 1100px;
            margin: 0 auto;
        }
        .navbar {
            background: #0b1a33;
            padding: 12px 20px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 30px;
        }
        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            color: white;
            font-size: 24px;
            font-weight: 700;
        }
        .logo span { color: #7aa9ff; }
        .logo-icon {
            background: #2a7de1;
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: white;
        }
        .nav-right {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }
        .balance-box {
            background: rgba(255,255,255,0.1);
            padding: 6px 16px;
            border-radius: 40px;
            color: white;
            font-weight: 700;
        }
        .balance-box i { color: #ffd700; }
        .user-id {
            background: #2a7de1;
            padding: 4px 14px;
            border-radius: 40px;
            font-size: 0.8rem;
            color: white;
            font-weight: 600;
        }
        .btn-logout {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            padding: 6px 16px;
            border-radius: 40px;
            color: white;
            cursor: pointer;
            font-weight: 500;
        }
        .btn-logout:hover { background: rgba(255,255,255,0.2); }
        .hidden { display: none !important; }
        .auth-box {
            max-width: 400px;
            margin: 40px auto;
            background: white;
            padding: 36px 32px;
            border-radius: 32px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.06);
        }
        .auth-box h2 { font-size: 1.8rem; margin-bottom: 4px; }
        .auth-box .sub { color: #4a5d78; margin-bottom: 24px; }
        .auth-box input {
            width: 100%;
            padding: 14px 16px;
            border-radius: 14px;
            border: 1.5px solid #e2eaf5;
            font-size: 1rem;
            margin-bottom: 12px;
            background: #fafcff;
        }
        .auth-box input:focus {
            outline: none;
            border-color: #2a7de1;
            background: white;
        }
        .auth-box .btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 60px;
            background: #0b1a33;
            color: white;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            margin-top: 4px;
        }
        .auth-box .btn:hover { background: #1d3b5e; }
        .auth-box .toggle {
            margin-top: 14px;
            text-align: center;
            color: #4a5d78;
        }
        .auth-box .toggle a {
            color: #2a7de1;
            font-weight: 600;
            cursor: pointer;
        }
        .msg {
            padding: 10px 14px;
            border-radius: 12px;
            margin-top: 10px;
            font-weight: 500;
            display: none;
        }
        .msg.success {
            display: block;
            background: #e6f7e6;
            color: #1a6e1a;
            border: 1px solid #b8e0b8;
        }
        .msg.error {
            display: block;
            background: #fde8e8;
            color: #a11f1f;
            border: 1px solid #f5c2c2;
        }
        .dashboard {
            background: white;
            border-radius: 24px;
            padding: 30px;
            border: 1px solid #eef4fc;
        }
        .greeting {
            margin-bottom: 24px;
            padding-bottom: 20px;
            border-bottom: 1px solid #eef4fc;
        }
        .greeting h2 { font-size: 1.8rem; }
        .greeting .sub { color: #4a5d78; }
        .grid-2 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 24px;
        }
        .card {
            background: #f8faff;
            border-radius: 20px;
            padding: 24px;
            border: 1px solid #eef4fc;
        }
        .card h3 {
            font-size: 1.2rem;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .card h3 i { color: #2a7de1; }
        .coin {
            width: 100px;
            height: 100px;
            background: radial-gradient(circle, #ffd700, #f0a500);
            border-radius: 50%;
            margin: 0 auto 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: white;
            cursor: pointer;
            user-select: none;
            box-shadow: 0 8px 25px rgba(240, 165, 0, 0.3);
        }
        .coin:active { transform: scale(0.92); }
        .clicker-info { text-align: center; color: #4a5d78; }
        .clicker-info span { font-weight: 700; color: #0b1a33; }
        .transfer-form input {
            width: 100%;
            padding: 12px 16px;
            border-radius: 14px;
            border: 1.5px solid #e2eaf5;
            font-size: 1rem;
            margin-bottom: 10px;
            background: white;
        }
        .transfer-form input:focus {
            outline: none;
            border-color: #2a7de1;
        }
        .transfer-form .btn-send {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 60px;
            background: #0b1a33;
            color: white;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
        }
        .transfer-form .btn-send:hover { background: #1d3b5e; }
        .info-box {
            margin-top: 24px;
            padding: 16px 20px;
            background: #f0f5fe;
            border-radius: 16px;
            border: 1px solid #dce7fa;
        }
        .info-box p { color: #2e405b; font-size: 0.95rem; }
        @media (max-width: 600px) {
            body { padding: 10px; }
            .navbar { flex-direction: column; align-items: stretch; }
            .nav-right { justify-content: center; }
            .dashboard { padding: 20px; }
        }
    </style>
</head>
<body>
<div class="container">
    <div class="navbar">
        <div class="logo">
            <div class="logo-icon">М</div>
            <span>М<span>Банк</span></span>
        </div>
        <div class="nav-right" id="navRight">
            <div class="balance-box hidden" id="balanceBox">
                <i class="fas fa-coins"></i> <span id="balanceNum">0</span> ₽
            </div>
            <span class="user-id hidden" id="userIdLabel">ID: —</span>
            <button class="btn-logout hidden" id="logoutBtn">Выйти</button>
        </div>
    </div>

    <div id="authBlock" class="auth-box">
        <h2 id="authTitle">Вход в МБанк</h2>
        <p class="sub" id="authSub">Войдите в свой аккаунт</p>
        <input type="text" id="authLogin" placeholder="Имя пользователя" />
        <input type="password" id="authPassword" placeholder="Пароль" />
        <button class="btn" id="authBtn">Войти</button>
        <div class="toggle">
            <span id="toggleText">Нет аккаунта?</span>
            <a id="toggleLink">Зарегистрироваться</a>
        </div>
        <div id="authMsg" class="msg"></div>
    </div>

    <div id="dashBlock" class="dashboard hidden">
        <div class="greeting">
            <h2 id="greetUser">Добро пожаловать!</h2>
            <p class="sub">ID: <strong id="dashId">—</strong> · Баланс: <strong id="dashBal">0 ₽</strong></p>
        </div>
        <div class="grid-2">
            <div class="card">
                <h3><i class="fas fa-hand-pointer"></i> Заработай</h3>
                <div style="text-align:center;">
                    <div class="coin" id="coinBtn">
                        <i class="fas fa-coins"></i>
                    </div>
                    <div class="clicker-info">
                        +1 ₽ за клик · Всего: <span id="clickCount">0</span>
                    </div>
                </div>
            </div>
            <div class="card">
                <h3><i class="fas fa-paper-plane"></i> Перевод</h3>
                <form class="transfer-form" id="transferForm">
                    <input type="text" id="transferId" placeholder="ID получателя (000002)" />
                    <input type="number" id="transferSum" placeholder="Сумма (₽)" min="1" />
                    <button type="submit" class="btn-send">
                        <i class="fas fa-arrow-right"></i> Перевести
                    </button>
                    <div id="transferMsg" class="msg"></div>
                </form>
            </div>
        </div>
        <div class="info-box">
            <p><i class="fas fa-info-circle" style="color:#2a7de1;"></i> 
                <strong>Как перевести:</strong> Узнайте ID друга в шапке. Введите его ID и сумму.
            </p>
        </div>
    </div>
</div>

<script>
    function getUsers() {
        try { return JSON.parse(localStorage.getItem('mbank_users')) || {}; } catch(e) { return {}; }
    }
    function saveUsers(users) { localStorage.setItem('mbank_users', JSON.stringify(users)); }
    function getSession() {
        try { return JSON.parse(localStorage.getItem('mbank_session')) || null; } catch(e) { return null; }
    }
    function saveSession(session) { localStorage.setItem('mbank_session', JSON.stringify(session)); }
    function clearSession() { localStorage.removeItem('mbank_session'); }

    function generateId() {
        const users = getUsers();
        let max = 0;
        for (let key in users) {
            let num = parseInt(key);
            if (!isNaN(num) && num > max) max = num;
        }
        return String(max + 1).padStart(6, '0');
    }

    function showMessage(element, text, type) {
        element.className = 'msg ' + type;
        element.textContent = text;
        element.style.display = 'block';
    }
    function hideMessage(element) { element.style.display = 'none'; }

    let isLoginMode = true;

    window.toggleAuthMode = function() {
        isLoginMode = !isLoginMode;
        document.getElementById('authTitle').textContent = isLoginMode ? 'Вход в МБанк' : 'Регистрация';
        document.getElementById('authSub').textContent = isLoginMode ? 'Войдите в свой аккаунт' : 'Создайте новый аккаунт';
        document.getElementById('authBtn').textContent = isLoginMode ? 'Войти' : 'Зарегистрироваться';
        document.getElementById('toggleText').textContent = isLoginMode ? 'Нет аккаунта?' : 'Уже есть аккаунт?';
        document.getElementById('toggleLink').textContent = isLoginMode ? 'Зарегистрироваться' : 'Войти';
        hideMessage(document.getElementById('authMsg'));
    };

    window.handleAuth = function() {
        const login = document.getElementById('authLogin').value.trim();
        const password = document.getElementById('authPassword').value.trim();
        const msgEl = document.getElementById('authMsg');

        if (!login || !password) {
            showMessage(msgEl, '❌ Заполните все поля', 'error');
            return;
        }

        const users = getUsers();

        if (isLoginMode) {
            let found = null;
            for (let id in users) {
                if (users[id].login === login && users[id].password === password) {
                    found = users[id];
                    break;
                }
            }
            if (!found) {
                showMessage(msgEl, '❌ Неверный логин или пароль', 'error');
                return;
            }
            saveSession({ userId: found.id });
            showDashboard();
        } else {
            for (let id in users) {
                if (users[id].login === login) {
                    showMessage(msgEl, '❌ Пользователь с таким именем уже есть', 'error');
                    return;
                }
            }
            const newId = generateId();
            users[newId] = {
                id: newId,
                login: login,
                password: password,
                balance: 100,
                clicks: 0
            };
            saveUsers(users);
            saveSession({ userId: newId });
            showMessage(msgEl, '✅ Аккаунт создан! ID: ' + newId, 'success');
            setTimeout(function() { showDashboard(); }, 500);
        }
    };

    window.logout = function() {
        clearSession();
        document.getElementById('dashBlock').classList.add('hidden');
        document.getElementById('authBlock').classList.remove('hidden');
        document.getElementById('balanceBox').classList.add('hidden');
        document.getElementById('userIdLabel').classList.add('hidden');
        document.getElementById('logoutBtn').classList.add('hidden');
        document.getElementById('authLogin').value = '';
        document.getElementById('authPassword').value = '';
        hideMessage(document.getElementById('authMsg'));
    };

    function showDashboard() {
        const session = getSession();
        if (!session) return;
        const users = getUsers();
        const user = users[session.userId];
        if (!user) { logout(); return; }

        document.getElementById('authBlock').classList.add('hidden');
        document.getElementById('dashBlock').classList.remove('hidden');
        document.getElementById('balanceBox').classList.remove('hidden');
        document.getElementById('balanceNum').textContent = user.balance;
        document.getElementById('userIdLabel').classList.remove('hidden');
        document.getElementById('userIdLabel').textContent = 'ID: ' + user.id;
        document.getElementById('logoutBtn').classList.remove('hidden');
        document.getElementById('greetUser').textContent = 'Привет, ' + user.login + '!';
        document.getElementById('dashId').textContent = user.id;
        document.getElementById('dashBal').textContent = user.balance + ' ₽';
        document.getElementById('clickCount').textContent = user.clicks || 0;
    }

    window.clickCoin = function() {
        const session = getSession();
        if (!session) return;
        const users = getUsers();
        const user = users[session.userId];
        if (!user) return;
        user.balance = (user.balance || 0) + 1;
        user.clicks = (user.clicks || 0) + 1;
        saveUsers(users);
        document.getElementById('balanceNum').textContent = user.balance;
        document.getElementById('dashBal').textContent = user.balance + ' ₽';
        document.getElementById('clickCount').textContent = user.clicks;
    };

    window.transferMoney = function(e) {
        e.preventDefault();
        const session = getSession();
        if (!session) return;
        const targetId = document.getElementById('transferId').value.trim();
        const amount = parseInt(document.getElementById('transferSum').value);
        const msgEl = document.getElementById('transferMsg');
        hideMessage(msgEl);

        if (!targetId || !/^\d{6}$/.test(targetId)) {
            showMessage(msgEl, '❌ Введите ID из 6 цифр (например, 000002)', 'error');
            return;
        }
        if (!amount || amount <= 0) {
            showMessage(msgEl, '❌ Введите сумму больше 0', 'error');
            return;
        }
        const users = getUsers();
        const sender = users[session.userId];
        const receiver = users[targetId];
        if (!sender) { logout(); return; }
        if (sender.id === targetId) {
            showMessage(msgEl, '❌ Нельзя перевести самому себе', 'error');
            return;
        }
        if (!receiver) {
            showMessage(msgEl, '❌ Пользователь с ID ' + targetId + ' не найден', 'error');
            return;
        }
        if (sender.balance < amount) {
            showMessage(msgEl, '❌ Не хватает денег. Баланс: ' + sender.balance + ' ₽', 'error');
            return;
        }
        sender.balance -= amount;
        receiver.balance = (receiver.balance || 0) + amount;
        saveUsers(users);
        document.getElementById('balanceNum').textContent = sender.balance;
        document.getElementById('dashBal').textContent = sender.balance + ' ₽';
        document.getElementById('transferId').value = '';
        document.getElementById('transferSum').value = '';
        showMessage(msgEl, '✅ Переведено ' + amount + ' ₽ пользователю ' + targetId, 'success');
    };

    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('authBtn').addEventListener('click', window.handleAuth);
        document.getElementById('toggleLink').addEventListener('click', window.toggleAuthMode);
        document.getElementById('coinBtn').addEventListener('click', window.clickCoin);
        document.getElementById('logoutBtn').addEventListener('click', window.logout);
        document.getElementById('transferForm').addEventListener('submit', window.transferMoney);
        document.getElementById('authLogin').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') window.handleAuth();
        });
        document.getElementById('authPassword').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') window.handleAuth();
        });
        const session = getSession();
        if (session) {
            const users = getUsers();
            if (users[session.userId]) {
                showDashboard();
                return;
            }
        }
        document.getElementById('authBlock').classList.remove('hidden');
        document.getElementById('dashBlock').classList.add('hidden');
    });
</script>
</body>
</html>
